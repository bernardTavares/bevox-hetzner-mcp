[Unit]
Description=bevox-hetzner-mcp control plane daemon (REST+MCP+reconciler)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=bevox
Group=bevox
WorkingDirectory=/opt/bevox-hetzner-mcp/core
Environment=NODE_ENV=production
# Use an absolute Node path; version-manager shims are not stable under systemd.
ExecStart=/usr/bin/node --env-file=.env dist/main.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
