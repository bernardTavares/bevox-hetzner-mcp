# core/.env.example — operator template. Copy to core/.env and fill the
# placeholders. core/.env is LOCAL-ONLY and gitignored: NEVER commit real
# secrets. This .env.example is committed and must contain only placeholders.
#
# CI runs `npm --prefix core test` + integration fakes on every commit;
# `@live` manual pre-release only.
# NOTE: Hetzner Cloud API is accessed via the core's own fetch-based
# http-client (no external SDK) — see core/src/providers/http-client.ts.
# Do NOT wrap values in quotes. The production run path (`npm --prefix core
# start` / `node --env-file-if-exists=core/.env core/dist/main.js`) parses this
# file with Node's NATIVE --env-file: it reads plain `KEY=value` lines and does
# NOT reliably strip surrounding quotes the way an ad-hoc parser might — quotes
# you add are taken literally and become part of the value. Provide each value
# raw and unquoted (this is also why the hand-rolled TEST harness note about
# quote-stripping does NOT apply to the daemon you actually run).
#
# Every key below WITHOUT a default is REQUIRED (mirrors ConfigSchema in
# core/src/config.ts). loadConfig() fails fast and value-free if any is
# absent/blank. Fill each placeholder; boot fails ONLY if a placeholder is
# left in place, never because a key was undocumented.

# ===========================================================================
# REQUIRED secrets / connection strings — NO DEFAULT (a missing one is fatal)
# ===========================================================================

# REQUIRED — PostgreSQL connection string for the observed-state store / pg
# pool / advisory locks / StateEvents. No default.
DATABASE_URL=postgres://user:replace-me@localhost:5432/bevox

# REQUIRED — Hetzner Cloud API token for HetznerCloudProvider
# (servers/networks/volumes). No default.
HCLOUD_TOKEN=<hetzner-cloud-api-token>

# REQUIRED — Hetzner DNS API token for HetznerDNSProvider (separate hcloud
# DNS API). No default.
HCLOUD_DNS_TOKEN=<hetzner-dns-api-token>

# REQUIRED — restic BackupProvider repository URL. No default.
RESTIC_REPO=s3:https://example.invalid/replace-me-bucket

# REQUIRED — restic repository password (secret). No default.
RESTIC_PASSWORD=replace-me

# REQUIRED — host for the Docker-Engine-over-SSH + WireGuard control
# transport. Put the server's REAL IP / hostname (the daemon SSHes here to
# drive Docker). See deploy/README.md "SSH control transport" for the full
# workflow. No default.
SSH_HOST=replace-me.example.invalid

# REQUIRED — SSH username for the control transport (the user the daemon logs
# in as on SSH_HOST). No default.
SSH_USER=replace-me

# REQUIRED — SSH private key (secret) for the control transport. SINGLE LINE
# with literal `\n` for newlines: Node --env-file does NOT unescape, so the
# daemon does (config.ts converts `\n`→newline and guarantees a trailing
# newline). The matching PUBLIC key must be registered in Hetzner Cloud SSH
# Keys and referenced per server as `servers[].ssh_keys: ["<key-name>"]` in the
# manifest so Hetzner injects it at create. To produce this value from a key
# file:  awk 'BEGIN{ORS="\\n"}1' ~/.ssh/bevox_daemon  (then paste). No default.
SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\nreplace-me\n-----END OPENSSH PRIVATE KEY-----

# REQUIRED — v1 injected credential-store seed: a JSON map of bearer
# token → {actor, capabilities} (the 4.2 agent credential seed). Secret;
# never logged. No default. Example shape (fake token):
AGENT_CREDENTIALS={"replace-me-token":{"actor":"agent:example","capabilities":["get_state","diff","events","health"]}}

# REQUIRED — sops-encrypted YAML with all bevox secrets (top-level keys = names).
# Operator workflow: see deploy/runbook-secrets-go-live.md §5.1.
# Paths MUST be absolute (no `~` expansion).
SECRETS_FILE=/home/<user>/.config/bevox/secrets.enc.yaml

# REQUIRED — age private key file (mode 0600 + owned by daemon user enforced at boot).
SOPS_AGE_KEY_FILE=/home/<user>/.config/bevox/age.key

# ===========================================================================
# OPTIONAL non-secret operational knobs — shown values are the DEFAULTS
# (omit / leave blank to use the default; never credentials)
# ===========================================================================

# Optional — loopback HTTP port for the REST server (0 ⇒ ephemeral).
PORT=8787

# Optional — periodic reconcile interval (ms).
RECONCILE_INTERVAL_MS=60000

# Optional — periodic drift-sweep interval (ms).
DRIFT_SWEEP_INTERVAL_MS=300000

# Optional — per-cycle reconcile deadline (ms).
CYCLE_TIMEOUT_MS=300000

# Optional — Pino log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# Optional — per-resolve sops subprocess timeout in ms. Range [1000, 60000].
# Default 5000. See docs/specs/2026-05-28-secret-resolver-real-v1.md §3.
SECRETS_TIMEOUT_MS=5000

# Optional — private-registry auth (Bug 11). JSON map registry-host → secret-ref.
# Each ref resolves (via SECRETS_FILE/sops, AT APPLY) to a credential JSON
# {"username":"…","password":"…"}. Absent ⇒ only public registries pull.
# See docs/specs/2026-06-01-docker-private-registry-auth.md.
# REGISTRY_AUTH_REFS={"ghcr.io":"ghcr-pat"}

# Optional — remote SSH port for the Docker/WireGuard/restic transport
# (Task 7.2). Default 22.
SSH_PORT=22

# Optional — host-key trust policy for the SSH transport (Task 7.2):
#   accept-new (DEFAULT) = TOFU: accept a NEW host key on first contact but
#                          REFUSE a CHANGED key (MITM-safe).
#   yes                  = require the host key to already be in known_hosts
#                          (strictest).
# A blanket accept-anything is DELIBERATELY NOT offered (silent MITM hole).
SSH_HOST_KEY_POLICY=accept-new

# Optional — explicit known_hosts file path for the SSH transport (Task 7.2).
# When set, the policy above is enforced against this operator-curated trust
# store (strongest posture). Leave blank for OpenSSH's default user
# known_hosts. Non-secret (a path).
SSH_KNOWN_HOSTS=

# Optional — managed mesh toggle. Default 'on' preserves 100% of v1
# behaviour: routes.server fans out to [HetznerCloud, WireGuard] and
# SSH_* env vars are required for any server-scope reconcile.
#
# Set MANAGED_MESH=off when the host network mesh is managed OUTSIDE the
# MCP (e.g., k3s/CNI), and you want the daemon to provision Hetzner
# servers via the Cloud API only. In that mode:
#   - routes.server = [HetznerCloud] (WireGuard backend not in the route)
#   - SSH_* env vars become OPTIONAL for server scope
#   - SSH_* still REQUIRED if a Service (Docker via SSH) is declared
#     (Docker is orthogonal to the managed mesh)
#
# Spec: docs/specs/2026-05-26-server-scope-transport-decoupling.md §4.3.
MANAGED_MESH=on

# Optional — managed services (Docker) toggle. Default 'on' preserves
# 100% of v1 behaviour: routes.service = Docker (over SSH) and the
# periodic reconcile cycle ticks the 'service' scope.
#
# Set MANAGED_SERVICES=off when container orchestration is managed
# OUTSIDE the MCP (e.g., k3s/CNI), and you want the daemon to be a
# pure Hetzner Cloud orchestrator (HTTP-only, zero SSH for services).
# In that mode:
#   - routes.service is undefined (no Docker backend in the route)
#   - the periodic reconcile cycle excludes the 'service' scope
#   - SSH_* env vars not required for service scope (they may still be
#     required for server scope unless MANAGED_MESH=off too)
#   - declaring a Service in the manifest raises a precondition error at
#     plan time (opt-out + Service are incompatible by construction)
#
# For the full "pure Hetzner Cloud HTTP" posture (k3s deploys), set both
# MANAGED_MESH=off and MANAGED_SERVICES=off.
#
# Spec: docs/specs/2026-05-26-tolerant-meta-scope-and-managed-services.md §3.
MANAGED_SERVICES=on

# ===========================================================================
# Test-only — used by the pg integration harness (not part of ConfigSchema)
# ===========================================================================

# PostgreSQL connection string used by integration fakes / local dev tests.
DATABASE_URL_TEST=postgres://user:replace-me@localhost:5432/bevox_test

# ===========================================================================
# run_migrations (v2 tool) — operator knobs
# ===========================================================================

# MIGRATION_TIMEOUT_MS — per-migration timeout for run_migrations (v2 tool).
#   Default: 60000 (60s). Range: [1000, 600000] (1s to 10min).
#   Bound is per-migration; a batch of 10 migrations can take up to 10x.
#   Operator splits a long migration into smaller ones if needed.
# MIGRATION_TIMEOUT_MS=60000
#
# The run_migrations capability — agents that need to apply migrations must
# include "run_migrations" in their capabilities array in AGENT_CREDENTIALS.
# Always-sensitive: every call requires Approval Gate approval.
